{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deliberately still hacklist-sf, though the project is now just
  // "hacklist". This name is the deployed hostname, and the published
  // calendar.ics feeds hang off it. A subscribed calendar that starts
  // 404ing does not warn anybody, it just quietly stops updating, so the
  // hostname is worth more than the consistency.
  "name": "hacklist-sf",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Where POST /api/events writes. Configuration only: this takes effect on the
  // next deploy through .github/workflows/discover.yml and provisions nothing.
  //
  // Analytics Engine datasets are created on first write, with no dashboard or
  // API step to run first, and the Workers Free plan includes 100,000 data
  // points written and 10,000 read queries a day, so this cannot start a bill:
  //   https://developers.cloudflare.com/analytics/analytics-engine/get-started/
  //   https://developers.cloudflare.com/analytics/analytics-engine/pricing/
  //
  // A full board is about 70 impressions, so the free daily allowance is
  // roughly 1,400 board views a day before sampling would matter. Rows are kept
  // for three months, which also caps how far any analysis can reach back:
  //   https://developers.cloudflare.com/analytics/analytics-engine/limits/
  //
  // The Worker treats this binding as optional. A build or a `wrangler dev`
  // without it serves the board and stores nothing, rather than failing.
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "hacklist_events"
    }
  ]
}
