{
  "name": "hacklist-sf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "discover:sf": "(node scripts/discover-search.mjs || true) && (node scripts/discover-linkedin.mjs || true) && node scripts/discover-sf.mjs && (node scripts/discover-yc.mjs || true) && (node scripts/discover-devpost.mjs || true) && node scripts/normalize-events.mjs",
    "discover:linkedin": "node scripts/discover-linkedin.mjs",
    "discover:yc": "node scripts/discover-yc.mjs",
    "normalize": "node scripts/normalize-events.mjs",
    "discover:personalized": "node scripts/discover-personalized.mjs",
    "luma:queue": "node scripts/luma-sync-ui.mjs --queue",
    "luma:sync": "node scripts/luma-sync-ui.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "discover:search": "node scripts/discover-search.mjs",
    "luma:tags": "node scripts/luma-tag-events.mjs",
    "cover": "node scripts/make-cover.mjs",
    "avatar": "node scripts/make-avatar.mjs",
    "banner": "node scripts/make-banner.mjs",
    "pfp": "node scripts/make-github-pfp.mjs",
    "sprites": "node scripts/extract-dino-sprite.mjs",
    "discover:luma-api": "node scripts/discover-luma-api.mjs",
    "discover:devpost": "node scripts/discover-devpost.mjs",
    "check:sources": "node scripts/check-sources.mjs"
  },
  "dependencies": {
    "@lightpanda/browser": "^1.2.0",
    "next": "^16.3.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
