{
  "name": "hacklist-sf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "discover:sf": "(node scripts/discover-search.mjs || true) && (node scripts/discover-linkedin.mjs || true) && (node scripts/discover-luma-api.mjs || true) && node scripts/discover-sf.mjs && (node scripts/discover-yc.mjs || true) && (node scripts/discover-devpost.mjs || true) && node scripts/normalize-events.mjs",
    "discover:linkedin": "node scripts/discover-linkedin.mjs",
    "discover:yc": "node scripts/discover-yc.mjs",
    "normalize": "node scripts/normalize-events.mjs",
    "discover:personalized": "node scripts/discover-personalized.mjs",
    "luma:queue": "node scripts/luma-sync-ui.mjs --queue",
    "luma:sync": "node scripts/luma-sync-ui.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "discover:search": "node scripts/discover-search.mjs",
    "luma:tags": "node scripts/luma-tag-events.mjs",
    "cover": "node scripts/make-cover.mjs",
    "avatar": "node scripts/make-avatar.mjs",
    "banner": "node scripts/make-banner.mjs",
    "pfp": "node scripts/make-github-pfp.mjs",
    "sprites": "node scripts/extract-dino-sprite.mjs",
    "discover:luma-api": "node scripts/discover-luma-api.mjs",
    "discover:devpost": "node scripts/discover-devpost.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "luma:export-session": "node scripts/export-luma-session.mjs",
    "test:artifact": "npm run build && node --test tests/rendered-html.test.mjs tests/discovery.test.mjs tests/dedupe.test.mjs tests/calendar-sync.test.mjs",
    "test:browser": "node --test tests/luma-external-form.test.mjs"
  },
  "dependencies": {
    "@lightpanda/browser": "^1.3.2",
    "next": "^16.3.1",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "^8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module",
  "overrides": {
    "undici": "^7.29.0",
    "ws": "^8.21.2",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3"
  }
}
